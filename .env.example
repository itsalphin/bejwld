# Copy to `.env` and fill in. All values here are safe placeholders.

# Signs the session cookie (mock cart + account). Use any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ── bejwld ──────────────────────────────────────────────────────────────────
# Sport-agnostic proof. The second capsule (tennis) already exists as data in
# app/lib/catalog/data.ts. Flip to "true" and restart to watch tennis appear in
# the nav, home rail, /collections, and search with NO code change.
VITE_BEJWLD_ENABLE_TENNIS=false

# Absolute base URL for canonicals, OG images, and the sitemap.
VITE_BEJWLD_SITE_URL=http://localhost:3000

# ── Shopify (only needed once a real store is connected) ─────────────────────
# PUBLIC_STORE_DOMAIN=your-shop.myshopify.com
# PUBLIC_CHECKOUT_DOMAIN=checkout.your-shop.com
